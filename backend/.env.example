# OmniChat AI - Environment Configuration
# Copy this file to .env and configure your settings

# ============================================================
# OLLAMA CONFIGURATION
# ============================================================
# Ollama server base URL
OLLAMA_BASE_URL=http://localhost:11434

# Primary text generation model (Llama 3.2 3B recommended)
LLM_MODEL=llama3.2:3b

# Vision-capable model for image and video frame analysis
# Must be a vision-capable Ollama model (e.g., llava, bakllava, or llama3.2-vision)
VISION_MODEL=llava:latest

# ============================================================
# EMBEDDINGS CONFIGURATION
# ============================================================
# Sentence Transformers model for text embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Fallback Ollama embedding model (used if Sentence Transformers fails)
EMBEDDING_FALLBACK_OLLAMA=nomic-embed-text

# ============================================================
# WHISPER (SPEECH-TO-TEXT) CONFIGURATION
# ============================================================
# Faster-Whisper model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=base

# Device: cpu, cuda (GPU acceleration if available)
WHISPER_DEVICE=cpu

# Compute type: int8 (CPU), float16 (GPU), float32
WHISPER_COMPUTE_TYPE=int8

# ============================================================
# RAG (RETRIEVAL) CONFIGURATION
# ============================================================
# Number of top chunks to retrieve for each query
TOP_K=5

# Chunk size in characters for text splitting
CHUNK_SIZE=800

# Overlap between chunks in characters
CHUNK_OVERLAP=100

# Number of recent conversation turns to include as context
HISTORY_WINDOW=8

# ============================================================
# VIDEO PROCESSING CONFIGURATION
# ============================================================
# Interval between sampled video frames in seconds
# Lower = more frames analyzed (slower, more detailed)
# Higher = fewer frames (faster, may miss details)
VIDEO_FRAME_INTERVAL=1.0

# ============================================================
# OCR CONFIGURATION
# ============================================================
# Minimum text length to avoid OCR on text-rich PDFs
OCR_MIN_TEXT_LENGTH=40

# Tesseract command path (leave as 'tesseract' if in PATH)
TESSERACT_CMD=tesseract

# ============================================================
# FILE STORAGE CONFIGURATION
# ============================================================
# Base data directory (all subdirectories created automatically)
DATA_DIR=data

# Upload directory
UPLOAD_DIR=data/uploads

# Processed files directory
PROCESSED_DIR=data/processed

# Extracted audio files
AUDIO_DIR=data/audio

# Extracted video frames
FRAMES_DIR=data/frames

# Exported files (chat history, summaries)
EXPORTS_DIR=data/exports

# ChromaDB persistent storage
CHROMA_DIR=data/chroma

# ============================================================
# FILE UPLOAD LIMITS
# ============================================================
# Maximum file size in MB
MAX_FILE_SIZE_MB=500
